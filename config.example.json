{
  "schemaVersion": 1,
  "approval": {
    "summaryMode": false
  },
  "appServer": {
    "mode": "owned_stdio",
    "socketPath": null
  },
  "codex": {
    "bin": "/absolute/path/to/codex",
    "cwd": "/absolute/path/to/resolved/config-home",
    "allowedShellCommands": ["ls", "pwd", "git", "find", "cd"]
  },
  "card": {
    "maxTextLength": 10000,
    "updateIntervalMs": 1500
  },
  "queue": {
    "maxQueuedTasks": 100
  },
  "usage": {
    "rateLimitQueryIntervalMs": 300000
  },
  "logging": {
    "toFile": false,
    "filePath": "bridge.log"
  },
  "files": {
    "enableAutoFileUpload": false
  }
}
